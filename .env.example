# Password for the login screen (required in production).
APP_PASSWORD=

# Optional: a long random string used to sign the session cookie.
SESSION_SECRET=

# Production database (Turso). Leave empty locally to use ./local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Food lookups (Claude). Without it, meals are entered by hand.
ANTHROPIC_API_KEY=
